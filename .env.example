# =============================================================================
# New Radar - Hermes Agent Configuration
# =============================================================================

# ====================== Database Configuration ======================
DB_HOST=db
DB_PORT=5432
DB_USER=radar
DB_PASSWORD=radar
DB_NAME=radar
DB_DIALECT=postgresql

# PostgreSQL Docker Container   
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar 
POSTGRES_DB=radar
POSTGRES_PORT=5444

# ====================== Hermes Agent ======================
HERMES_HOME=/app/.hermes
PYTHONPATH=/app/hermes-agent:/app

# ====================== LLM Providers ======================
# DeepSeek (recommended for cost-effectiveness)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# Kimi/Moonshot (recommended for long context)
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL_NAME=kimi-k2-0711-preview

# OpenAI compatible endpoints
OPENAI_API_KEY=sk-dummy
OPENAI_BASE_URL=http://localhost:8642/v1
OPENAI_MODEL_NAME=new-radar-agent

# ====================== Search APIs ======================
# Anspire
ANSPIRE_API_KEY=your-anspire-api-key
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search
ANSPIRE_PRO_BASE_URL=https://plugin.anspire.cn/api/ntsearch/prosearch
ANSPIRE_USE_PRO=True

# Bocha
BOCHA_WEB_API_KEY=your-bocha-api-key
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search

# Tavily
TAVILY_API_KEY=your-tavily-api-key

# Firecrawl
FIRECRAWL_API_KEY=your-firecrawl-api-key
FIRECRAWL_API_URL=https://api.firecrawl.dev/v0

# ====================== MCP Servers ======================
ENABLE_TAVILY=True
ENABLE_BOCHA=False
ENABLE_ANSPIRE=True
ENABLE_FIRECRAWL=False
ENABLE_SENTIMENT_TOOL=False

# ====================== Crawler Configuration ======================
CRAWLER_OUTPUT_DIR=./output
SEARCH_CONTENT_MAX_LENGTH=3000
MAX_SEARCH_RESULTS_FOR_LLM=20

# ====================== Embedding Model ======================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# HuggingFace Mirror
HF_ENDPOINT=https://hf-mirror.com
